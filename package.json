{
  "name": "aniket-giriyalkar-portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:game": "node scripts/sync-game.mjs",
    "sync:football": "node scripts/sync-football-lab.mjs",
    "sync:assets": "npm run sync:game && npm run sync:football",
    "predev": "npm run sync:assets",
    "dev": "next dev",
    "prebuild": "npm run sync:assets",
    "build": "next build",
    "start": "npx serve out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test games/emberbound/tests/*.test.js",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.9",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
